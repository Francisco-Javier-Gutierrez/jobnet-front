# AWS Cognito Configuration
COGNITO_CLIENT_ID=your_cognito_client_id_here
COGNITO_CLIENT_SECRET=your_cognito_client_secret_here
NUXT_PUBLIC_COGNITO_DOMAIN=jobnet-auth-prod.auth.us-east-1.amazoncognito.com
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_your_user_pool_id_here
COGNITO_REGION=us-east-1

# Nuxt Auth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NUXT_AUTH_ORIGIN=http://localhost:3000

{
  "name": "jobnet-front",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@sidebase/nuxt-auth": "^0.9.1",
    "leaflet": "^1.9.4",
    "next-auth": "4.21.1",
    "nuxt": "^4.4.8",
    "pinia": "^2.3.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@pinia/nuxt": "^0.9.0",
    "@types/leaflet": "^1.9.12",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  },
  "overrides": {
    "vue-router": {
      "pinia": "^2.3.1"
    }
  }
}

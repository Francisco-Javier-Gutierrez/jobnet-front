#!/bin/sh

# Hook pre-push: Bloquea push directo a main o master a menos que sea aprobado por Jenkins
if [ "$JENKINS_GATEKEEPER_APPROVED" = "true" ]; then
    echo "🔓 [Gatekeeper] Autorización de Jenkins detectada. Permitiendo promoción a producción..."
    exit 0
fi

while read local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo ""
            echo "🛑 ============================================================"
            echo "⛔ ACCESO DENEGADO A RAMA PROTEGIDA ($remote_ref)"
            echo "============================================================"
            echo "👉 En JobNet, la rama de producción ('main') está blindada."
            echo "👉 No se permite hacer push directo a main sin pasar por Jenkins."
            echo ""
            echo "🚀 Para auditar tu código y promoverlo a producción de forma segura:"
            echo "   npm run jenkins"
            echo "============================================================"
            echo ""
            exit 1
            ;;
    esac
done

echo ""
echo "🚀 [Git Hook: Pre-Push] Validando código antes de subir a GitHub..."
npm run check

EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ ============================================================"
    echo "⛔ ERROR: El push fue cancelado porque npm run check falló."
    echo "============================================================"
    echo ""
    exit $EXIT_CODE
fi

echo "✅ [Pre-Push] Código verificado. Subiendo cambios a GitHub..."
exit 0
